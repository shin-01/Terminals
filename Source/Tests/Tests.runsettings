<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!--
    The suite shares global singletons (Settings.Instance, FileLocations,
    PersistenceSecurity) across test classes; running classes in parallel
    produces cross-test configuration races (password upgrade tests reading
    another test's config). Force serial execution.
  -->
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
  </RunConfiguration>
  <MSTest>
    <Parallelize>
      <Workers>1</Workers>
      <Scope>ClassLevel</Scope>
    </Parallelize>
  </MSTest>
</RunSettings>
