<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!--
    The suite shares global singletons (Settings.Instance, FileLocations,
    PersistenceSecurity) across test classes; running classes in parallel
    produces cross-test configuration races (password upgrade tests reading
    another test's config). Force serial execution.
    Many tests host WinForms controls, which requires single thread
    apartment (STA) threads; the test platform defaults to MTA.
  -->
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <ExecutionThreadApartmentState>STA</ExecutionThreadApartmentState>
  </RunConfiguration>
  <MSTest>
    <Parallelize>
      <Workers>1</Workers>
      <Scope>ClassLevel</Scope>
    </Parallelize>
  </MSTest>
</RunSettings>
