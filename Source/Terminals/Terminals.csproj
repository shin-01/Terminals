<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Terminals</AssemblyName>
    <RootNamespace>Terminals</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>terminalsicon.ico</ApplicationIcon>
    <PlatformTarget>x86</PlatformTarget>
    <OutputPath Condition="'$(Configuration)'=='Debug'">..\..\Build\Output\Debug\</OutputPath>
    <OutputPath Condition="'$(Configuration)'=='Release'">..\..\Build\Output\Release\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="5.0.0" />
    <PackageReference Include="FluentValidation" Version="6.2.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SharpZipLib" Version="1.3.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AxInterop.MSTSCLib">
      <HintPath>..\..\Resources\Libraries\mstsc\AxInterop.MSTSCLib.dll</HintPath>
    </Reference>
    <Reference Include="MSTSCLib">
      <HintPath>..\..\Resources\Libraries\mstsc\MSTSCLib.dll</HintPath>
    </Reference>
    <Reference Include="ZedGraph">
      <HintPath>..\..\Resources\Libraries\ZedGraph\ZedGraph.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.configuration" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Design" />
    <Reference Include="System.DirectoryServices" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Transactions" />
    <Reference Include="System.Web.Services" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HexEditor\HexEditor.csproj" />
    <ProjectReference Include="..\Metro\Metro.csproj" />
    <ProjectReference Include="..\TabControl\TabControl.csproj" />
    <ProjectReference Include="..\Terminals.Common\Terminals.Common.csproj" />
    <ProjectReference Include="..\Terminals.External\Terminals.External.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Data\DB\DataBase.cs" />
    <Compile Remove="Data\DB\SQLPersistence1.cs" />
    <Compile Remove="Data\Validation\DbFavoriteMetaData.cs" />
    <Compile Remove="ExportImport\ExportImport.cs" />
    <Compile Remove="Network\DNS\Adapter.cs" />
    <Compile Remove="Network\DNS\AdapterInfo.cs" />
    <Compile Remove="TerminalServices\WTSApi32.cs" />
    <Compile Remove="Unified\RSS\Weather.cs" />
    <Compile Remove="Updates\RSS\Weather.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
    <None Include="Terminals.log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="ToolStrip.settings.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="terminalsicon.ico" />
  </ItemGroup>

</Project>
